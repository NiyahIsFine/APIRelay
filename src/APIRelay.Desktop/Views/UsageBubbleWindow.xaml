<Window x:Class="APIRelay.Desktop.Views.UsageBubbleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:APIRelay.Desktop.Localization" Width="252" Height="96" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Border Background="#F21B2330" BorderBrush="#3F5A65" BorderThickness="1" CornerRadius="14" Padding="16,11" Margin="2">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{loc:Tr ShowWindow}" Click="Open_Click" />
        <MenuItem Header="{loc:Tr HideBubble}" Click="Hide_Click" />
        <Separator />
        <MenuItem Header="{loc:Tr Quit}" Click="Quit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="BubbleContent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel>
        <TextBlock Text="{Binding BubbleCost}" Foreground="#62D5BF" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Right" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#62D5BF" Margin="0,0,7,0" />
          <TextBlock Text="APIRelay" Foreground="#EDF3FA" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,10,0,0" ToolTip="{Binding BubbleTokens, StringFormat={}{0} tokens}">
        <TextBlock Text="{Binding BubbleInput, StringFormat=↓ {0}}" Foreground="#AFBED0" FontSize="11" ToolTip="{loc:Tr Input}" />
        <TextBlock Text="{Binding BubbleOutput, StringFormat=↑ {0}}" Foreground="#AFBED0" FontSize="11" Margin="14,0,0,0" ToolTip="{loc:Tr Output}" />
        <TextBlock Text="{Binding BubbleRate}" Foreground="#AFBED0" FontSize="11" HorizontalAlignment="Right" />
      </DockPanel>
      <Popup x:Name="CostToastPopup" Grid.RowSpan="2" Placement="Top" PlacementTarget="{Binding ElementName=BubbleContent}" AllowsTransparency="True" PopupAnimation="None" StaysOpen="True" Focusable="False" IsHitTestVisible="False">
        <Grid x:Name="CostToastLayer" Width="{Binding ActualWidth, ElementName=BubbleContent}" Height="48" IsHitTestVisible="False">
          <TextBlock x:Name="CostToast" Text="{Binding LastRequestCost}" Foreground="#62D5BF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0">
            <TextBlock.RenderTransform>
              <TranslateTransform x:Name="CostToastOffset" />
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
              <DropShadowEffect Color="#101820" BlurRadius="4" ShadowDepth="1" Opacity="0.8" />
            </TextBlock.Effect>
          </TextBlock>
        </Grid>
      </Popup>
    </Grid>
  </Border>
</Window>
