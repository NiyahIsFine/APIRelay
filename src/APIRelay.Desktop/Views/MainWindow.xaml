<ui:FluentWindow x:Class="APIRelay.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:APIRelay.Desktop.Localization" xmlns:pages="clr-namespace:APIRelay.Desktop.Views.Pages" Title="APIRelay" Width="1440" Height="940" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" WindowBackdropType="None" ExtendsContentIntoTitleBar="True" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Icon="pack://application:,,,/Assets/app.ico" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="APIRelay" ShowHelp="False" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="16,22,16,18">
          <ListBox SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Home24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Overview}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DataHistogram24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Requests}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Server24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Providers}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Cube24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Models}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Money24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Pricing}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Clients}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Document24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Logs}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" FontSize="19" Margin="0,0,13,0" />
                <TextBlock Text="{loc:Tr Settings}" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="72" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="30,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="{loc:Tr Start}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryAction}" />
              <ui:Button Content="{loc:Tr Stop}" Command="{Binding StopCommand}" Style="{StaticResource Action}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Margin="0,0,9,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding RunningText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LocalUrl}" Foreground="{DynamicResource MutedTextBrush}" Margin="18,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Margin="30,16,30,0" Padding="14,10">
          <DockPanel>
            <ui:Button Content="×" Command="{Binding DismissNoticeCommand}" DockPanel.Dock="Right" Padding="5,0" Appearance="Transparent" ToolTip="{loc:Tr Close}" />
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="30,26,30,22">
          <TabControl SelectedIndex="{Binding SelectedPage}" Style="{StaticResource PageHost}">
            <TabItem>
              <pages:OverviewView />
            </TabItem>
            <TabItem>
              <pages:RequestsView />
            </TabItem>
            <TabItem>
              <pages:ProvidersView />
            </TabItem>
            <TabItem>
              <pages:ModelsView />
            </TabItem>
            <TabItem>
              <pages:PricingView />
            </TabItem>
            <TabItem>
              <pages:ClientsView />
            </TabItem>
            <TabItem>
              <pages:LogsView />
            </TabItem>
            <TabItem>
              <pages:SettingsView />
            </TabItem>
          </TabControl>
        </Grid>
        <ProgressBar Grid.Row="2" VerticalAlignment="Top" IsIndeterminate="True" Height="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
