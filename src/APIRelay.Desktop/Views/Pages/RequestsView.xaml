<UserControl x:Class="APIRelay.Desktop.Views.Pages.RequestsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:APIRelay.Desktop.Localization">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="{loc:Tr Requests}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Tr RequestsHint}" Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,16">
      <ui:TextBox Text="{Binding RecordSearch, UpdateSourceTrigger=PropertyChanged}" Width="230" Style="{StaticResource SearchField}" ToolTip="{loc:Tr Search}" Margin="0,0,12,8" PlaceholderText="{loc:Tr Search}" AutomationProperties.Name="{loc:Tr Search}" />
      <ComboBox ItemsSource="{Binding RecordDates}" SelectedItem="{Binding SelectedDate}" ItemStringFormat="yyyy-MM-dd" Width="135" Style="{StaticResource Select}" Margin="0,0,12,8" />
      <CheckBox Content="{loc:Tr AllDates}" IsChecked="{Binding AllDates}" VerticalAlignment="Center" Margin="0,0,16,8" />
      <ui:Button Content="{loc:Tr Refresh}" Command="{Binding RefreshRecordsCommand}" Style="{StaticResource Action}" />
      <ui:Button Content="{loc:Tr ClearDate}" Command="{Binding ClearDateCommand}" Style="{StaticResource Action}" />
      <ui:Button Content="{loc:Tr ClearAll}" Command="{Binding ClearAllCommand}" Style="{StaticResource Action}" />
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0">
      <Grid>
        <DataGrid ItemsSource="{Binding RecordsView}" SelectedItem="{Binding SelectedRecord}" Style="{StaticResource DataTable}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Tr Time}" Binding="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="145" />
            <DataGridTextColumn Header="{loc:Tr Model}" Binding="{Binding Model}" Width="180" />
            <DataGridTextColumn Header="{loc:Tr Status}" Binding="{Binding StatusCode}" Width="65" />
            <DataGridTextColumn Header="{loc:Tr Input}" Binding="{Binding Input, StringFormat=N0}" Width="95" />
            <DataGridTextColumn Header="{loc:Tr Output}" Binding="{Binding Output, StringFormat=N0}" Width="85" />
            <DataGridTextColumn Header="{loc:Tr CacheRead}" Binding="{Binding CacheRead, StringFormat=N0}" Width="95" />
            <DataGridTextColumn Header="{loc:Tr CacheWrite}" Binding="{Binding CacheWrite, StringFormat=N0}" Width="95" />
            <DataGridTextColumn Header="{loc:Tr TotalTokens}" Binding="{Binding Total, StringFormat=N0}" Width="100" />
            <DataGridTextColumn Header="{loc:Tr Cost}" Binding="{Binding Cost, StringFormat={}{0:$0.0000}}" Width="100" />
            <DataGridTextColumn Header="{loc:Tr Duration}" Binding="{Binding Duration, StringFormat={}{0} ms}" Width="95" />
            <DataGridTextColumn Header="{loc:Tr FirstByte}" Binding="{Binding FirstByte, StringFormat={}{0} ms}" Width="95" />
            <DataGridTextColumn Header="{loc:Tr Summary}" Binding="{Binding Summary}" Width="240" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Visibility="{Binding NoRecords, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr NoRecords}" FontSize="20" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr NoRecordsHint}" Style="{StaticResource Subtitle}" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" MaxHeight="200" Visibility="{Binding HasSelectedRecord, Converter={StaticResource BoolVisibility}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,22,0">
            <TextBlock Text="{loc:Tr RequestDetail}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding SelectedRecord.Model}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedRecord.Path}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,6" />
            <TextBox Text="{Binding SelectedRecord.Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{loc:Tr CostDetails}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding SelectedRecord.CostDescription}" Style="{StaticResource Subtitle}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
