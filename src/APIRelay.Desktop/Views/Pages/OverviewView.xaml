<UserControl x:Class="APIRelay.Desktop.Views.Pages.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:APIRelay.Desktop.Localization" xmlns:chart="clr-namespace:APIRelay.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,6,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <ComboBox ItemsSource="{Binding RecordDates}" SelectedItem="{Binding SelectedDate}" ItemStringFormat="yyyy-MM-dd" Width="138" Style="{StaticResource Select}" />
          <CheckBox Content="{loc:Tr AllDates}" IsChecked="{Binding AllDates}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Margin="0,0,0,24">
          <TextBlock Text="{loc:Tr Overview}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{loc:Tr OverviewHint}" Style="{StaticResource Subtitle}" />
        </StackPanel>
      </DockPanel>
      <UniformGrid Columns="4" Margin="0,0,-14,0">
        <Border Style="{StaticResource Card}" Margin="0,0,14,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr Input}" Style="{StaticResource MetricLabel}" />
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34">
              <TextBlock Text="{Binding InputTotal}" Style="{StaticResource MetricValue}" />
            </Viewbox>
            <TextBlock Text="{Binding InputCost}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,14,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr Output}" Style="{StaticResource MetricLabel}" />
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34">
              <TextBlock Text="{Binding OutputTotal}" Style="{StaticResource MetricValue}" />
            </Viewbox>
            <TextBlock Text="{Binding OutputCost}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,14,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr CacheRead}" Style="{StaticResource MetricLabel}" />
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34">
              <TextBlock Text="{Binding CacheReadTotal}" Style="{StaticResource MetricValue}" />
            </Viewbox>
            <TextBlock Text="{Binding CacheReadCost}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,14,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr TotalCost}" Style="{StaticResource MetricLabel}" />
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34">
              <TextBlock Text="{Binding CostTotal}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource AccentBrush}" />
            </Viewbox>
            <TextBlock Text="{Binding TokenTotal}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Padding="22,18">
        <UniformGrid Columns="4">
          <StackPanel>
            <TextBlock Text="{loc:Tr TotalRequests}" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="{Binding RequestCount}" FontWeight="SemiBold" FontSize="17" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{loc:Tr CacheRate}" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="{Binding CacheRate}" FontWeight="SemiBold" FontSize="17" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{loc:Tr CacheWrite}" Style="{StaticResource MetricLabel}" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding CacheWriteTotal}" FontWeight="SemiBold" FontSize="17" />
              <TextBlock Text="{Binding CacheWriteCost}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{loc:Tr TotalTokens}" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="{Binding TokenTotal}" FontWeight="SemiBold" FontSize="17" />
          </StackPanel>
        </UniformGrid>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <CheckBox DockPanel.Dock="Right" Content="{loc:Tr Cost}" IsChecked="{Binding UseCostChart}" />
            <TextBlock Text="{loc:Tr UsageTrend}" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <chart:UsageChart Points="{Binding ChartPoints}" ShowCost="{Binding UseCostChart}" Height="232" />
          <WrapPanel Margin="58,16,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
              <Ellipse Width="6" Height="6" Fill="#62D5BF" Margin="0,0,7,0" />
              <TextBlock Text="{loc:Tr Input}" Style="{StaticResource Subtitle}" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
              <Ellipse Width="6" Height="6" Fill="#82A7F7" Margin="0,0,7,0" />
              <TextBlock Text="{loc:Tr Output}" Style="{StaticResource Subtitle}" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
              <Ellipse Width="6" Height="6" Fill="#C59CED" Margin="0,0,7,0" />
              <TextBlock Text="{loc:Tr CacheRead}" Style="{StaticResource Subtitle}" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
              <Ellipse Width="6" Height="6" Fill="#F5BE76" Margin="0,0,7,0" />
              <TextBlock Text="{loc:Tr CacheWrite}" Style="{StaticResource Subtitle}" FontSize="11" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{loc:Tr ViewAll}" Command="{Binding ViewRequestsCommand}" />
            <TextBlock Text="{loc:Tr LastRequests}" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <StackPanel Visibility="{Binding NoRecords, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" Margin="20,30">
            <ui:SymbolIcon Symbol="DataHistogram24" FontSize="30" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{loc:Tr NoRecords}" HorizontalAlignment="Center" Margin="0,12,0,8" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr NoRecordsHint}" Style="{StaticResource Subtitle}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding RecentRecords}" Visibility="{Binding HasRecords, Converter={StaticResource BoolVisibility}}" Style="{StaticResource DataTable}" IsReadOnly="True" MaxHeight="310">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Tr Time}" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="90" />
              <DataGridTextColumn Header="{loc:Tr Model}" Binding="{Binding Model}" Width="2*" />
              <DataGridTextColumn Header="{loc:Tr Status}" Binding="{Binding StatusCode}" Width="70" />
              <DataGridTextColumn Header="{loc:Tr Tokens}" Binding="{Binding Total, StringFormat=N0}" Width="110" />
              <DataGridTextColumn Header="{loc:Tr Duration}" Binding="{Binding Duration, StringFormat={}{0} ms}" Width="100" />
              <DataGridTextColumn Header="{loc:Tr Cost}" Binding="{Binding Cost, StringFormat={}{0:$0.0000}}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
