<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ico\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ico\app.ico" LogicalName="APIRelay.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="APIRelay.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <Target Name="BuildSingleExe" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingSingleExe)' != 'true'">
    <PropertyGroup>
      <_SingleExePublishDir>$(BaseIntermediateOutputPath)single-exe\$(Configuration)\</_SingleExePublishDir>
      <_SingleExeOutput>$(TargetDir)$(AssemblyName)-single.exe</_SingleExeOutput>
    </PropertyGroup>

    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c &quot;$(Configuration)&quot; -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=none -p:DebugSymbols=false -p:BuildingSingleExe=true -o &quot;$(_SingleExePublishDir)&quot;" />
    <Copy SourceFiles="$(_SingleExePublishDir)$(AssemblyName).exe" DestinationFiles="$(_SingleExeOutput)" />
    <RemoveDir Directories="$(_SingleExePublishDir);$(TargetDir)win-x64" />
  </Target>

</Project>